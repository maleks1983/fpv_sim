<Window x:Class="FpvTelemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FCAT2 — UART телеметрія" Height="650" Width="980"
        MinHeight="560" MinWidth="820" Background="#0C1220"
        Foreground="#EAF0FA" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="COM-порт" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="PortCombo" Grid.Column="1" Height="34" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Швидкість" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="BaudCombo" Grid.Column="4" Height="34" VerticalContentAlignment="Center" SelectedIndex="3">
                    <ComboBoxItem Content="9600"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="57600"/>
                    <ComboBoxItem Content="115200"/><ComboBoxItem Content="230400"/>
                </ComboBox>
                <Button x:Name="RefreshButton" Grid.Column="6" Content="Оновити" Padding="16,6" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button x:Name="ConnectButton" Grid.Column="7" Content="Підключити" Padding="16,6" Click="Connect_Click"/>
                <CheckBox x:Name="SimulationCheck" Grid.Column="9" Content="Імітація без плати" VerticalAlignment="Center"
                          Margin="18,0,0,0" Checked="Simulation_Checked" Unchecked="Simulation_Unchecked"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="28">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="ПОТОЧНЕ ПОВІДОМЛЕННЯ" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="TelemetryText" Grid.Row="1" Text="ОЧІКУВАННЯ" FontFamily="Consolas" FontSize="48"
                               FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="#65E4A3"/>
                    <TextBlock x:Name="LastUpdateText" Grid.Row="2" Text="Дані ще не отримано" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="СТАН З'ЄДНАННЯ" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#EF5B5B" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusText" Text="Відключено" FontSize="16"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="ЖУРНАЛ" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <ListBox x:Name="LogList" Grid.Row="4" Margin="0,10,0,0" Background="#101827" Foreground="#CBD5E5"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock x:Name="PacketCountText" Text="Коректних пакетів: 0   •   Помилок CRC: 0" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock HorizontalAlignment="Right" Text="MSPv2 0x3007  •  USART2  •  115200 8N1" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
    </Grid>
</Window>
